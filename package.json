{
  "name": "coderexic",
  "private": true,
  "description": "Context-aware agentic GitHub pull request review platform",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @coderexic/api dev",
    "dev:worker": "pnpm --filter @coderexic/worker dev",
    "db:generate": "pnpm --filter @coderexic/core db:generate",
    "db:migrate": "pnpm --filter @coderexic/api db:migrate",
    "github:smoke": "pnpm --filter @coderexic/api github:smoke",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tests --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@coderexic/core": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
