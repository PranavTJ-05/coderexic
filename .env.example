# Copy to .env for local development: cp .env.example .env
# Never commit .env. Later phases add GitHub App, model provider and
# encryption settings here.

NODE_ENV=development
LOG_LEVEL=debug

# API
HOST=127.0.0.1
PORT=3000

# Matches the postgres and redis services in docker-compose.yml.
# docker compose also reads this file: if 5432/6379/3000 are taken on your
# machine, change the host ports below and the URLs to match.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000
DATABASE_URL=postgres://coderexic:coderexic@localhost:5432/coderexic
REDIS_URL=redis://localhost:6379
