# Copy to .env for local development: cp .env.example .env
# Never commit .env. Later phases add encryption settings here.

NODE_ENV=development
LOG_LEVEL=debug

# API
HOST=127.0.0.1
PORT=3000

# Matches the postgres and redis services in docker-compose.yml.
# docker compose also reads this file: if 5432/6379/3000 are taken on your
# machine, change the host ports below and the URLs to match.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000
DATABASE_URL=postgres://coderexic:coderexic@localhost:5432/coderexic
REDIS_URL=redis://localhost:6379

# Optional: servers for `pnpm test:integration` (default to DATABASE_URL /
# REDIS_URL). Tests create and drop their own throwaway database and queue.
# TEST_DATABASE_URL=postgres://coderexic:coderexic@localhost:5432/coderexic
# TEST_REDIS_URL=redis://localhost:6379

# GitHub App (see docs/github-app.md). Empty values count as unset.
# The API needs the webhook secret to start, even before an App exists:
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Needed by anything calling the GitHub API (pnpm github:smoke, workers).
GITHUB_APP_ID=
# Path to the downloaded .pem (keep it outside the repo, chmod 600).
GITHUB_PRIVATE_KEY_PATH=
# Or inline, for secret managers (\n escapes allowed):
# GITHUB_PRIVATE_KEY=
# Local webhook relay channel (docs/github-app.md).
# SMEE_URL=https://smee.io/your-channel

# Model provider (the worker, ROADMAP.md Phase 10). Which one actually runs a
# review - only that provider's key is required; the others can stay unset.
# MODEL_PROVIDER=gemini
# MODEL_PROVIDER=openai
# MODEL_PROVIDER=anthropic
# MODEL_PROVIDER=groq

# Gemini. Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Pinned to a specific, non-preview model on purpose; see packages/core/src/llm/gemini.ts.
# GEMINI_MODEL=gemini-3.6-flash

# OpenAI. Get a key at https://platform.openai.com/api-keys.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1

# Anthropic. Get a key at https://console.anthropic.com/settings/keys.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Groq (OpenAI-compatible API). Get a key at https://console.groq.com/keys.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# How many review jobs one worker process runs at once.
# REVIEW_CONCURRENCY=2

# Off by default. Set to "true" to switch reviews from the one-shot Gemini
# path to the tool-calling agent loop (ROADMAP.md Phase 9) - many more model
# calls per review, so leave this off until you've watched it run.
# AGENT_LOOP_ENABLED=false
