# Copy to apps/web/.env.local for local development. Never commit .env.local.
# Next.js reads env from this app's own directory, not the root .env the
# other apps share - see the note in the root .env.example.

# NODE_ENV is not set here - Next.js sets it itself (development/production
# depending on dev vs. build) and overriding it can produce confusing bugs.
LOG_LEVEL=debug

# Same Postgres/Redis as the rest of the stack (docker-compose.yml).
DATABASE_URL=postgres://coderexic:coderexic@localhost:5432/coderexic
REDIS_URL=redis://localhost:6379

# The GitHub App's own OAuth client (App settings -> General -> "Client ID" /
# "Client secret" - not a separate OAuth App). Authorizing this App is what
# yields a user-to-server token that can call GET /user/installations
# (packages/core/src/github/user-access.ts).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs and encrypts the session JWT. Generate with `openssl rand -base64 32`.
AUTH_SECRET=

# Required: next-auth defaults to http://localhost:3000 when this is unset,
# which is the wrong port here (apps/api also defaults to 3000; `pnpm
# --filter @coderexic/web dev` runs on :3001 - see package.json).
NEXTAUTH_URL=http://localhost:3001

# In the GitHub App's settings, the OAuth callback URL must be set to
# exactly NEXTAUTH_URL + /api/auth/callback/github, e.g.:
#   http://localhost:3001/api/auth/callback/github   (local dev)
#   https://<your-domain>/api/auth/callback/github    (production)

# Optional (Phase 13b). The App's URL slug (Settings -> General -> "Public
# page", the last path segment), used to build the "install the app" link
# on the dashboard's empty state. Without it, that link is simply omitted.
GITHUB_APP_SLUG=
